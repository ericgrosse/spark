{
  "name": "@spark/desktop",
  "version": "0.1.0",
  "description": "Spark desktop shell for Windows, macOS, and Linux.",
  "author": "Spark",
  "private": true,
  "type": "module",
  "main": "src/main.js",
  "scripts": {
    "dev": "electron .",
    "build": "electron-builder",
    "test": "node --test test/*.test.mjs",
    "lint": "eslint src --ext .js",
    "typecheck": "tsc --allowJs --checkJs --noEmit --module NodeNext --moduleResolution NodeNext --target ES2022 --esModuleInterop --skipLibCheck src/main.js"
  },
  "devDependencies": {
    "electron": "42.2.0",
    "electron-builder": "^26.0.12",
    "eslint": "^9.6.0",
    "typescript": "^5.5.3"
  },
  "build": {
    "appId": "com.example.sparkdating",
    "productName": "Spark",
    "files": ["src/**/*", "../../apps/web/dist/**/*"],
    "directories": {
      "output": "release"
    },
    "mac": {
      "target": ["dmg"]
    },
    "win": {
      "target": ["nsis"]
    },
    "linux": {
      "target": ["AppImage", "deb"]
    }
  }
}
